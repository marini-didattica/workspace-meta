#!/usr/bin/env bash
# wm — workspace-meta helper: coordinate the sibling repositories of the workspace.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
WORKSPACE_META="$(dirname -- "$SCRIPT_DIR")"
WORKSPACE_ROOT="$(dirname -- "$WORKSPACE_META")"
ORG="${WM_ORG:-marini-didattica}"

die() { printf 'wm: %s\n' "$*" >&2; exit 1; }

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency '$1'${2:+ — $2}"
}

highlight() { gum style --bold --foreground 212 -- "$1"; }

usage() {
  cat <<EOF
wm — workspace-meta helper (workspace root: $WORKSPACE_ROOT)

Usage:
  wm git clone     Clone repositories from $ORG
  wm git status    Run git status in the local repositories
  wm foreach       Run a command in each local repository
  wm deps bump-slidev  Update the in-house slidev deps in the local repositories
  wm deps bump-typst   Update the shared typst submodules, then commit and push
  wm exam watch-corrections [correzioni-dir] [--out out-dir]
                    Generate correction stubs and watch them with typst
  wm exam deploy <exam-dir> [--force]
                    Deploy corrections and answers to student private folders
  wm help          Show this help
EOF
}

# Names of the git repositories found next to workspace-meta.
local_repos() {
  local dir name
  for dir in "$WORKSPACE_ROOT"/*/; do
    [ -e "$dir/.git" ] || continue
    name="$(basename -- "$dir")"
    printf '%s\n' "$name"
  done
}

# Names of the repositories in the GitHub organization.
org_repos() {
  gh repo list "$ORG" --limit 1000 --json name --jq '.[].name' | sort
}

cmd_git_clone() {
  require gum "install it from https://github.com/charmbracelet/gum"
  require gh "install it from https://cli.github.com"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run 'gh auth login'"

  local -a repos
  mapfile -t repos < <(org_repos)
  ((${#repos[@]})) || die "no repositories found in organization '$ORG'"

  # Default selection: everything except workspace-meta.
  local r
  local -a defaults=()
  for r in "${repos[@]}"; do
    [ "$r" = "workspace-meta" ] || defaults+=("$r")
  done

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Clone from $ORG" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local -a chosen
  mapfile -t chosen <<< "$picks"

  local dir list=""
  dir="$(pwd)"
  for r in "${chosen[@]}"; do
    list+="  - $r"$'\n'
  done
  gum confirm "The following repos will be cloned in $dir:"$'\n\n'"$list" || exit 0

  for r in "${chosen[@]}"; do
    highlight "==> $r"
    gh repo clone "$ORG/$r" || true
  done
}

cmd_git_status() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  local picks
  picks="$(gum choose --no-limit --selected '*' --header "git status" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local r
  while IFS= read -r r; do
    highlight "==> $r"
    git -C "$WORKSPACE_ROOT/$r" status || true
  done <<< "$picks"
}

cmd_foreach() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  local picks
  picks="$(gum choose --no-limit --selected '*' --header "Repositories" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --placeholder "e.g. git fetch --all")" || exit 0
  [ -n "$command" ] || die "no command provided"

  local r
  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

# Repositories whose package.json depends on the in-house slidev theme/addons.
slide_repos() {
  local r
  for r in "$@"; do
    grep -qE '"marini-slidev-(theme|addons)"[[:space:]]*:' "$WORKSPACE_ROOT/$r/package.json" 2>/dev/null && printf '%s\n' "$r"
  done
}

# Repositories using the shared typst theme/components as git submodules.
typst_repos() {
  local r
  for r in "$@"; do
    grep -qE 'typst-(theme|components)' "$WORKSPACE_ROOT/$r/.gitmodules" 2>/dev/null && printf '%s\n' "$r"
  done
}

cmd_deps_bump_slidev() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  # Default selection: the repositories using the marini-slidev-* dependencies.
  local r
  local -a defaults=()
  mapfile -t defaults < <(slide_repos "${repos[@]}")

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Repositories to update" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --value "bun update marini-slidev-theme marini-slidev-addons && git add --all && git commit -m'chore: bumped git deps' && git push")" || exit 0
  [ -n "$command" ] || die "no command provided"

  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

cmd_deps_bump_typst() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  # Default selection: the repositories using the typst theme/components submodules.
  local r
  local -a defaults=()
  mapfile -t defaults < <(typst_repos "${repos[@]}")

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Repositories to update" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --value "git submodule update --remote --merge --recursive && git submodule foreach --quiet 'cd \"\$toplevel\" && git add -- \"\$displaypath\"' && if ! git diff --cached --quiet; then git commit -m 'chore: bump typst deps' && git push; fi")" || exit 0
  [ -n "$command" ] || die "no command provided"

  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

# Escape a value for use inside a Typst string literal.
typst_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

# Find the project root containing the shared typst-components package.
typst_root_for() {
  local dir="$1"
  while :; do
    if [ -d "$dir/typst-components" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname -- "$dir")"
  done
  return 1
}

# Generate one Typst stub per correction JSON and watch all of them.
cmd_exam_watch_corrections() {
  require typst "install it from https://typst.app"

  local out="/tmp/marini-didattica/exams"
  local src=""

  while (($#)); do
    case "$1" in
      --out)
        (($# >= 2)) || die "--out requires a directory"
        out="$2"
        shift 2
        ;;
      --out=*)
        out="${1#--out=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      --)
        shift
        while (($#)); do
          [ -z "$src" ] || die "exam watch-corrections accepts at most one corrections directory"
          src="$1"
          shift
        done
        ;;
      -*)
        die "unknown option '$1' for exam watch-corrections"
        ;;
      *)
        [ -z "$src" ] || die "exam watch-corrections accepts at most one corrections directory"
        src="$1"
        shift
        ;;
    esac
  done

  if [ -z "$src" ]; then
    if [ -d "./correzioni" ]; then
      src="./correzioni"
    else
      src="."
    fi
  fi
  [ -d "$src" ] || die "corrections directory not found: $src"

  local src_abs out_abs
  src_abs="$(cd -- "$src" && pwd)"
  mkdir -p -- "$out"
  out_abs="$(cd -- "$out" && pwd)"

  local root
  root="$(typst_root_for "$src_abs")" || die "no typst-components directory found above $src_abs"
  local package="$root/typst-components/src/correction.typ"
  [ -f "$package" ] || die "correction entrypoint not found: $package"

  local typ_dir="$out_abs/typ"
  local pdf_dir="$out_abs/pdf"
  mkdir -p -- "$typ_dir" "$pdf_dir"

  # Remove stale generated stubs so the output reflects the current source.
  find "$typ_dir" -maxdepth 1 -type f -name '*.typ' -delete

  shopt -s nullglob
  local files=("$src_abs"/*.json)
  shopt -u nullglob

  local -a stubs=()
  local -a pdfs=()
  local json name stub pdf template
  template="$(typst_escape "$package")"

  for json in "${files[@]}"; do
    if ! grep -q '"test-json"' "$json" || ! grep -q '"exercises"' "$json"; then
      printf 'wm: skipping %s (not a correction descriptor)\n' "$json" >&2
      continue
    fi

    name="$(basename -- "$json" .json)"
    stub="$typ_dir/$name.typ"
    pdf="$pdf_dir/$name.pdf"

    {
      printf '#import "%s": render-correction\n\n' "$template"
      printf '#render-correction(path("%s"))\n' "$(typst_escape "$json")"
    } >"$stub"

    stubs+=("$stub")
    pdfs+=("$pdf")
  done

  ((${#stubs[@]})) || die "no correction descriptors found in $src_abs"

  printf 'Watching %d correction file(s)\n' "${#stubs[@]}"
  printf '  typ: %s\n  pdf: %s\n' "$typ_dir" "$pdf_dir"

  local -a pids=()
  local i
  for i in "${!stubs[@]}"; do
    typst watch --root / "${stubs[$i]}" "${pdfs[$i]}" &
    pids+=("$!")
  done

  cleanup() {
    local pid
    for pid in "${pids[@]}"; do
      kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  wait || true
}

# Find the materiale repository root (contains content/students.json).
materiale_root_for() {
  local dir="$1"
  while :; do
    if [ -f "$dir/content/students.json" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname -- "$dir")"
  done
  return 1
}

# Resolve a descriptor path: relative to its JSON, or to the repo root.
descriptor_path() {
  local base="$1"
  local value="$2"
  local root="$3"
  if [[ "$value" == /* ]]; then
    realpath -m -- "$root$value"
  else
    (cd -- "$base" && realpath -m -- "$value")
  fi
}

# Deploy correction descriptors and student answers into each private area.
cmd_exam_deploy() {
  require jq "install it from https://jqlang.github.io/jq/"

  local force=0
  local exam=""

  while (($#)); do
    case "$1" in
      --force|-f)
        force=1
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      --)
        shift
        while (($#)); do
          [ -z "$exam" ] || die "exam deploy accepts exactly one exam directory"
          exam="$1"
          shift
        done
        ;;
      -*)
        die "unknown option '$1' for exam deploy"
        ;;
      *)
        [ -z "$exam" ] || die "exam deploy accepts exactly one exam directory"
        exam="$1"
        shift
        ;;
    esac
  done

  [ -n "$exam" ] || die "usage: wm exam deploy <exam-dir> [--force]"
  [ -d "$exam" ] || die "exam directory not found: $exam"

  local exam_abs root admin_root students
  exam_abs="$(cd -- "$exam" && pwd -P)"
  root="$(materiale_root_for "$exam_abs")" || die "could not find content/students.json above $exam_abs"
  admin_root="$root/content/raw/private/admin"
  students="$root/content/students.json"

  case "$exam_abs" in
    "$admin_root"/*) ;;
    *) die "exam directory must be under $admin_root" ;;
  esac

  local rel class exam_name corrections
  rel="${exam_abs#"$admin_root"/}"
  class="$(basename -- "$(dirname -- "$rel")")"
  exam_name="$(basename -- "$exam_abs")"
  corrections="$exam_abs/correzioni"

  [ -d "$corrections" ] || die "corrections directory not found: $corrections"

  shopt -s nullglob
  local files=("$corrections"/*.json)
  shopt -u nullglob

  local deployed=0
  local skipped=0
  local json student key answer_rel answer_abs test_rel test_abs target answers_target
  local src_file rel_file dst_file typ dst_json test_json_rel schema_rel schema_abs

  for json in "${files[@]}"; do
    if ! grep -q '"test-json"' "$json" || ! grep -q '"exercises"' "$json"; then
      printf 'wm: skipping %s (not a correction descriptor)\n' "$json" >&2
      continue
    fi

    student="$(basename -- "$json" .json)"
    key="$class/$student"

    if ! jq -e --arg key "$key" 'has($key)' "$students" >/dev/null; then
      die "student '$key' not found in $students"
    fi

    answer_rel="$(jq -r '."answer-folder" // empty' "$json")"
    [ -n "$answer_rel" ] || die "$json: missing answer-folder"

    test_rel="$(jq -r '."test-json" // empty' "$json")"
    [ -n "$test_rel" ] || die "$json: missing test-json"

    answer_abs="$(descriptor_path "$corrections" "$answer_rel" "$root")"
    [ -d "$answer_abs" ] || die "$json: answer folder not found: $answer_abs"

    test_abs="$(descriptor_path "$corrections" "$test_rel" "$root")"
    [ -f "$test_abs" ] || die "$json: test JSON not found: $test_abs"

    target="$root/content/raw/private/$class/$student/$exam_name"
    answers_target="$target/le-tue-risposte"
    mkdir -p -- "$answers_target"

    printf '==> %s -> %s\n' "$key" "$target"

    typ="$target/correzione.typ"
    if [ -e "$typ" ] && [ "$force" -eq 0 ]; then
      printf '  skip existing %s\n' "$typ" >&2
      skipped=$((skipped + 1))
    else
      cat >"$typ" <<'EOF'
#import "/typst-components/src/correction.typ": render-correction

#render-correction(path("correzione.json"))
EOF
      printf '  wrote %s\n' "$typ"
      deployed=$((deployed + 1))
    fi

    dst_json="$target/correzione.json"
    if [ -e "$dst_json" ] && [ "$force" -eq 0 ]; then
      printf '  skip existing %s\n' "$dst_json" >&2
      skipped=$((skipped + 1))
    else
      test_json_rel="$(realpath --relative-to="$target" -- "$test_abs")"
      schema_rel=""
      schema_abs="$root/content/raw/private/admin/misc/correction.schema.json"
      if [ -f "$schema_abs" ]; then
        schema_rel="$(realpath --relative-to="$target" -- "$schema_abs")"
      fi

      jq --arg answer_folder "le-tue-risposte" \
        --arg test_json "$test_json_rel" \
        --arg schema "$schema_rel" \
        '."answer-folder" = $answer_folder
         | ."test-json" = $test_json
         | if $schema != "" then .["$schema"] = $schema else . end' \
        "$json" >"$dst_json.tmp"
      mv -f -- "$dst_json.tmp" "$dst_json"

      printf '  copied %s\n' "$dst_json"
      deployed=$((deployed + 1))
    fi

    while IFS= read -r -d '' src_file; do
      rel_file="${src_file#"$answer_abs"/}"
      dst_file="$answers_target/$rel_file"

      if [ -e "$dst_file" ] && [ "$force" -eq 0 ]; then
        printf '  skip existing %s\n' "$dst_file" >&2
        skipped=$((skipped + 1))
        continue
      fi

      mkdir -p -- "$(dirname -- "$dst_file")"
      cp -f -- "$src_file" "$dst_file"
      printf '  copied %s\n' "$dst_file"
      deployed=$((deployed + 1))
    done < <(find "$answer_abs" -type f -print0 | sort -z)
  done

  printf 'Deployed %d file(s), skipped %d existing file(s).\n' "$deployed" "$skipped"
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    git)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        clone) cmd_git_clone "$@" ;;
        status) cmd_git_status "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    foreach) cmd_foreach "$@" ;;
    exam)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        watch-corrections) cmd_exam_watch_corrections "$@" ;;
        deploy) cmd_exam_deploy "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    deps)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        bump-slidev) cmd_deps_bump_slidev "$@" ;;
        bump-typst) cmd_deps_bump_typst "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try 'wm help')" ;;
  esac
}

main "$@"
