#!/usr/bin/env bash
# wm — workspace-meta helper: coordinate the sibling repositories of the workspace.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
WORKSPACE_META="$(dirname -- "$SCRIPT_DIR")"
WORKSPACE_ROOT="$(dirname -- "$WORKSPACE_META")"
ORG="${WM_ORG:-marini-didattica}"

die() { printf 'wm: %s\n' "$*" >&2; exit 1; }

require() {
  command -v "$1" >/dev/null 2>&1 || die "missing dependency '$1'${2:+ — $2}"
}

highlight() { gum style --bold --foreground 212 -- "$1"; }

usage() {
  cat <<EOF
wm — workspace-meta helper (workspace root: $WORKSPACE_ROOT)

Usage:
  wm git clone     Clone repositories from $ORG
  wm git status    Run git status in the local repositories
  wm foreach       Run a command in each local repository
  wm deps bump-slidev  Update the in-house slidev deps in the local repositories
  wm deps bump-typst   Update the shared typst submodules, then commit and push
  wm exam watch-corrections [correzioni-dir] [--out out-dir]
                    Generate correction stubs and watch them with typst
  wm help          Show this help
EOF
}

# Names of the git repositories found next to workspace-meta.
local_repos() {
  local dir name
  for dir in "$WORKSPACE_ROOT"/*/; do
    [ -e "$dir/.git" ] || continue
    name="$(basename -- "$dir")"
    printf '%s\n' "$name"
  done
}

# Names of the repositories in the GitHub organization.
org_repos() {
  gh repo list "$ORG" --limit 1000 --json name --jq '.[].name' | sort
}

cmd_git_clone() {
  require gum "install it from https://github.com/charmbracelet/gum"
  require gh "install it from https://cli.github.com"
  gh auth status >/dev/null 2>&1 || die "gh is not authenticated — run 'gh auth login'"

  local -a repos
  mapfile -t repos < <(org_repos)
  ((${#repos[@]})) || die "no repositories found in organization '$ORG'"

  # Default selection: everything except workspace-meta.
  local r
  local -a defaults=()
  for r in "${repos[@]}"; do
    [ "$r" = "workspace-meta" ] || defaults+=("$r")
  done

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Clone from $ORG" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local -a chosen
  mapfile -t chosen <<< "$picks"

  local dir list=""
  dir="$(pwd)"
  for r in "${chosen[@]}"; do
    list+="  - $r"$'\n'
  done
  gum confirm "The following repos will be cloned in $dir:"$'\n\n'"$list" || exit 0

  for r in "${chosen[@]}"; do
    highlight "==> $r"
    gh repo clone "$ORG/$r" || true
  done
}

cmd_git_status() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  local picks
  picks="$(gum choose --no-limit --selected '*' --header "git status" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local r
  while IFS= read -r r; do
    highlight "==> $r"
    git -C "$WORKSPACE_ROOT/$r" status || true
  done <<< "$picks"
}

cmd_foreach() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  local picks
  picks="$(gum choose --no-limit --selected '*' --header "Repositories" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --placeholder "e.g. git fetch --all")" || exit 0
  [ -n "$command" ] || die "no command provided"

  local r
  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

# Repositories whose package.json depends on the in-house slidev theme/addons.
slide_repos() {
  local r
  for r in "$@"; do
    grep -qE '"marini-slidev-(theme|addons)"[[:space:]]*:' "$WORKSPACE_ROOT/$r/package.json" 2>/dev/null && printf '%s\n' "$r"
  done
}

# Repositories using the shared typst theme/components as git submodules.
typst_repos() {
  local r
  for r in "$@"; do
    grep -qE 'typst-(theme|components)' "$WORKSPACE_ROOT/$r/.gitmodules" 2>/dev/null && printf '%s\n' "$r"
  done
}

cmd_deps_bump_slidev() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  # Default selection: the repositories using the marini-slidev-* dependencies.
  local r
  local -a defaults=()
  mapfile -t defaults < <(slide_repos "${repos[@]}")

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Repositories to update" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --value "bun update marini-slidev-theme marini-slidev-addons && git add --all && git commit -m'chore: bumped git deps' && git push")" || exit 0
  [ -n "$command" ] || die "no command provided"

  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

cmd_deps_bump_typst() {
  require gum "install it from https://github.com/charmbracelet/gum"

  local -a repos
  mapfile -t repos < <(local_repos)
  ((${#repos[@]})) || die "no local repositories found in $WORKSPACE_ROOT"

  # Default selection: the repositories using the typst theme/components submodules.
  local r
  local -a defaults=()
  mapfile -t defaults < <(typst_repos "${repos[@]}")

  local -a sel_args=()
  if ((${#defaults[@]})); then
    sel_args=(--selected "$(IFS=,; printf '%s' "${defaults[*]}")")
  fi

  local picks
  picks="$(gum choose --no-limit "${sel_args[@]}" --header "Repositories to update" -- "${repos[@]}")" || exit 0
  [ -n "$picks" ] || exit 0

  local command
  command="$(gum input --header "Command to run in each repository" --value "git submodule update --remote --merge --recursive && git submodule foreach --quiet 'cd \"\$toplevel\" && git add -- \"\$displaypath\"' && if ! git diff --cached --quiet; then git commit -m 'chore: bump typst deps' && git push; fi")" || exit 0
  [ -n "$command" ] || die "no command provided"

  while IFS= read -r r; do
    highlight "==> $r"
    (cd "$WORKSPACE_ROOT/$r" && bash -c "$command") || true
  done <<< "$picks"
}

# Escape a value for use inside a Typst string literal.
typst_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

# Find the project root containing the shared typst-components package.
typst_root_for() {
  local dir="$1"
  while :; do
    if [ -d "$dir/typst-components" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    [ "$dir" = "/" ] && break
    dir="$(dirname -- "$dir")"
  done
  return 1
}

# Generate one Typst stub per correction JSON and watch all of them.
cmd_exam_watch_corrections() {
  require typst "install it from https://typst.app"

  local out="/tmp/marini-didattica/exams"
  local src=""

  while (($#)); do
    case "$1" in
      --out)
        (($# >= 2)) || die "--out requires a directory"
        out="$2"
        shift 2
        ;;
      --out=*)
        out="${1#--out=}"
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      --)
        shift
        while (($#)); do
          [ -z "$src" ] || die "exam watch-corrections accepts at most one corrections directory"
          src="$1"
          shift
        done
        ;;
      -*)
        die "unknown option '$1' for exam watch-corrections"
        ;;
      *)
        [ -z "$src" ] || die "exam watch-corrections accepts at most one corrections directory"
        src="$1"
        shift
        ;;
    esac
  done

  if [ -z "$src" ]; then
    if [ -d "./correzioni" ]; then
      src="./correzioni"
    else
      src="."
    fi
  fi
  [ -d "$src" ] || die "corrections directory not found: $src"

  local src_abs out_abs
  src_abs="$(cd -- "$src" && pwd)"
  mkdir -p -- "$out"
  out_abs="$(cd -- "$out" && pwd)"

  local root
  root="$(typst_root_for "$src_abs")" || die "no typst-components directory found above $src_abs"
  local package="$root/typst-components/src/correction.typ"
  [ -f "$package" ] || die "correction entrypoint not found: $package"

  local typ_dir="$out_abs/typ"
  local pdf_dir="$out_abs/pdf"
  mkdir -p -- "$typ_dir" "$pdf_dir"

  # Remove stale generated stubs so the output reflects the current source.
  find "$typ_dir" -maxdepth 1 -type f -name '*.typ' -delete

  shopt -s nullglob
  local files=("$src_abs"/*.json)
  shopt -u nullglob

  local -a stubs=()
  local -a pdfs=()
  local json name stub pdf template
  template="$(typst_escape "$package")"

  for json in "${files[@]}"; do
    if ! grep -q '"test-json"' "$json" || ! grep -q '"exercises"' "$json"; then
      printf 'wm: skipping %s (not a correction descriptor)\n' "$json" >&2
      continue
    fi

    name="$(basename -- "$json" .json)"
    stub="$typ_dir/$name.typ"
    pdf="$pdf_dir/$name.pdf"

    {
      printf '#import "%s": render-correction\n\n' "$template"
      printf '#render-correction(path("%s"))\n' "$(typst_escape "$json")"
    } >"$stub"

    stubs+=("$stub")
    pdfs+=("$pdf")
  done

  ((${#stubs[@]})) || die "no correction descriptors found in $src_abs"

  printf 'Watching %d correction file(s)\n' "${#stubs[@]}"
  printf '  typ: %s\n  pdf: %s\n' "$typ_dir" "$pdf_dir"

  local -a pids=()
  local i
  for i in "${!stubs[@]}"; do
    typst watch --root / "${stubs[$i]}" "${pdfs[$i]}" &
    pids+=("$!")
  done

  cleanup() {
    local pid
    for pid in "${pids[@]}"; do
      kill "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
  }
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  wait || true
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    git)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        clone) cmd_git_clone "$@" ;;
        status) cmd_git_status "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    foreach) cmd_foreach "$@" ;;
    exam)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        watch-corrections) cmd_exam_watch_corrections "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    deps)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        bump-slidev) cmd_deps_bump_slidev "$@" ;;
        bump-typst) cmd_deps_bump_typst "$@" ;;
        *) usage >&2; exit 1 ;;
      esac
      ;;
    ""|-h|--help|help) usage ;;
    *) die "unknown command '$cmd' (try 'wm help')" ;;
  esac
}

main "$@"
