{
	"$schema": "https://opencode.ai/config.json",

	"lsp": true,

	"mcp": {
		"code-graph": {
			"type": "local",
			"command": ["bunx", "-y", "@sdsrs/code-graph"]
		},

		"chrome-devtools": {
			"type": "local",
			"command": [
				"bunx",
				"-y",
				"chrome-devtools-mcp@latest",
				"--no-usage-statistics",
				"--executablePath",
				"/usr/bin/chromium",
				"--headless"
			]
		},

		"slidev": {
			"type": "remote",
			"url": "http://localhost:3030/__mcp"
		}
	},

	"permission": {
		"lsp": "allow"
	}
}
