{
	"$schema": "https://opencode.ai/config.json",
	"instructions": ["./AGENTS.md"],

	"lsp": true,

	"mcp": {
		"code-graph": {
			"type": "local",
			"command": ["bunx", "-y", "@sdsrs/code-graph@latest"],
			"environment": {
				"CODE_GRAPH_FORCE_PLUGIN_MCP": "1"
			}
		},

		"chrome-devtools": {
			"type": "local",
			"command": [
				"bunx",
				"-y",
				"chrome-devtools-mcp@latest",
				"--no-usage-statistics",
				"--executablePath",
				"/usr/bin/chromium",
				"--headless"
			]
		},

		"context7": {
			"type": "local",
			"command": ["bunx", "-y", "@upstash/context7-mcp"]
		}

		// "slidev": {
		// 	"type": "remote",
		// 	"url": "http://localhost:3030/__mcp"
		// }
	},

	"permission": {
		"lsp": "allow"
	}
}
